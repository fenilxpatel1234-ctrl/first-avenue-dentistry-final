    isNewPatient: true,
    status: 'Pending',
    createdAt: new Date().toISOString()
  };

  appointmentDatabase.unshift(newAppointment);
  persistAppointments();
  sendNewAppointmentNotification(newAppointment);

  return res.status(201).json({ success: true, appointment: newAppointment });
});

// 2. Admin Get Appointments
