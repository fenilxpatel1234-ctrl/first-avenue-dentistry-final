// Password Hashing (Salted SHA-256)
function hashPassword(password: string): string {
  const salt = crypto.randomBytes(16).toString('hex');
  const hash = crypto.createHash('sha256').update(salt + password).digest('hex');
  return `sha256$${salt}$${hash}`;
}

function verifyPassword(stored: string, test: string): boolean {
  if (!stored.startsWith('sha256$')) return stored === test;
  const [, salt, hash] = stored.split('$');
  const candidate = crypto.createHash('sha256').update(salt + test).digest('hex');
  return candidate === hash;
}

