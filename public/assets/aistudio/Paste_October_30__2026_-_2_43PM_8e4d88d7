// 6. Admin Login
app.post('/api/admin/login', (req: Request, res: Response) => {
  const { username, password } = req.body;
  const admin = adminDatabase.find(a => a.username === username || a.email === username);
  if (!admin || !verifyPassword(admin.password, password)) {
