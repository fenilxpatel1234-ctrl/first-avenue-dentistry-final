function parseCookies(req: Request): Record<string, string> {
  const list: Record<string, string> = {};
  for (const part of (req.headers.cookie || '').split(';')) {
    const [k, v] = part.split('=');
    if (k && v) list[k.trim()] = v.trim();
  }
  return list;
}

