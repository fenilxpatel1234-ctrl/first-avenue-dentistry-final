## 4. AI Conversational Booking Concierge (`src/components/DentalConciergeAI.tsx`)
*State machine: Conversational Q&A $\rightarrow$ In-flight edits $\rightarrow$ Direct API submission*

```tsx
import React, { useState, useEffect, useRef } from 'react';
import { Bot, Send, X, Calendar, Check, ArrowRight } from 'lucide-react';

type BookingStage =
  | null
  | 'service'
  | 'firstName'
  | 'lastName'
  | 'email'
  | 'phone'
  | 'date'
  | 'time'
  | 'confirm';

export const DentalConciergeAI: React.FC<{ isOpen: boolean; onClose: () => void }> = ({ isOpen, onClose }) => {
  const [messages, setMessages] = useState<Array<{ id: string; sender: 'ai' | 'user'; text: string }>>([
    { id: '1', sender: 'ai', text: "Hello! I'm your First Avenue Dental Concierge. How can I help you today?" }
  ]);
  const [input, setInput] = useState('');
  const [stage, setStage] = useState<BookingStage>(null);
  const [data, setData] = useState({
    serviceName: '', firstName: '', lastName: '', email: '', phone: '', date: '', time: ''
  });
  const [loading, setLoading] = useState(false);
  const scrollRef = useRef<HTMLDivElement>(null);

  useEffect(() => {
    scrollRef.current?.scrollIntoView({ behavior: 'smooth' });
  }, [messages]);

  if (!isOpen) return null;

  const addMsg = (sender: 'ai' | 'user', text: string) => {
    setMessages(prev => [...prev, { id: Date.now().toString(), sender, text }]);
  };

  const handleSend = async () => {
    const text = input.trim();
    if (!text) return;
    setInput('');
    addMsg('user', text);

    if (stage) {
      handleBookingStateMachine(text);
      return;
    }

    setLoading(true);
    try {
      const res = await fetch('/api/ai/dental-assistant', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: text })
      });
      const resData = await res.json();
      addMsg('ai', resData.answer);
      if (resData.action === 'booking_start') {
        setStage('service');
      }
    } catch {
      addMsg('ai', 'Feel free to call us directly at (519) 207-6890 for quick assistance!');
    } finally {
      setLoading(false);
    }
  };

  const handleBookingStateMachine = async (val: string) => {
    switch (stage) {
      case 'service':
        setData(d => ({ ...d, serviceName: val }));
        setStage('firstName');
        addMsg('ai', `Understood, ${val}. What is your first name?`);
        break;
      case 'firstName':
        setData(d => ({ ...d, firstName: val }));
        setStage('lastName');
        addMsg('ai', `Nice to meet you! What is your last name?`);
        break;
      case 'lastName':
        setData(d => ({ ...d, lastName: val }));
        setStage('email');
        addMsg('ai', `Thank you. What is the best email address for your confirmation?`);
        break;
      case 'email':
        setData(d => ({ ...d, email: val }));
        setStage('phone');
        addMsg('ai', `Got it. What phone number can we reach you at?`);
        break;
      case 'phone':
        setData(d => ({ ...d, phone: val }));
        setStage('date');
        addMsg('ai', `What preferred date works for your visit (YYYY-MM-DD or e.g., 'next Monday')?`);
        break;
      case 'date':
        setData(d => ({ ...d, date: val }));
        setStage('time');
        addMsg('ai', `What time slot do you prefer (e.g., '10:00 AM' or '02:30 PM')?`);
        break;
      case 'time':
        setData(d => ({ ...d, time: val }));
        setStage('confirm');
        addMsg('ai', `Please confirm your details:\n• Service: ${data.serviceName}\n• Patient: ${data.firstName} ${data.lastName}\n• Email: ${data.email}\n• Phone: ${data.phone}\n• Slot: ${data.date} at ${val}\n\nType 'yes' to submit or 'change [field]' to update.`);
        break;
      case 'confirm':
        if (['yes', 'yep', 'confirm', 'correct'].includes(val.toLowerCase())) {
          submitBooking();
        } else if (val.toLowerCase().includes('change') || val.toLowerCase().includes('edit')) {
          setStage('date');
          addMsg('ai', "Let's update your booking date. What new date do you prefer?");
        } else {
          addMsg('ai', "Please reply 'yes' to confirm your reservation or 'change' to edit.");
        }
        break;
    }
  };

  const submitBooking = async () => {
    setLoading(true);
    try {
      const res = await fetch('/api/appointments', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          firstName: data.firstName,
          lastName: data.lastName,
          email: data.email,
          phone: data.phone,
          serviceName: data.serviceName,
          preferredDate: data.date,
          preferredTimeSlot: data.time
        })
      });
      const result = await res.json();
      if (result.success) {
        addMsg('ai', "🎉 Your appointment request is submitted! We just sent an acknowledgment email to your inbox.");
        setStage(null);
      }
    } catch {
      addMsg('ai', "We encountered a network issue submitting your appointment. Please call (519) 207-6890.");
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="fixed bottom-6 right-6 w-96 h-[550px] bg-white rounded-2xl shadow-2xl border border-slate-200 flex flex-col z-50 overflow-hidden">
      <div className="bg-gradient-to-r from-blue-600 to-cyan-600 p-4 text-white flex justify-between items-center">
        <div className="flex items-center gap-2">
          <Bot className="w-5 h-5" />
          <span className="font-semibold text-sm">Dental Concierge AI</span>
        </div>
        <button onClick={onClose}><X className="w-5 h-5 text-white/80 hover:text-white" /></button>
      </div>

      <div className="flex-1 p-4 overflow-y-auto space-y-3 bg-slate-50 text-sm">
        {messages.map(m => (
          <div key={m.id} className={`flex ${m.sender === 'user' ? 'justify-end' : 'justify-start'}`}>
            <div className={`p-3 rounded-2xl max-w-[80%] whitespace-pre-line ${
              m.sender === 'user' ? 'bg-blue-600 text-white rounded-br-none' : 'bg-white text-slate-800 shadow-sm border border-slate-200 rounded-bl-none'
            }`}>
              {m.text}
            </div>
          </div>
        ))}
        {loading && <div className="text-xs text-slate-400 italic">Typing response...</div>}
        <div ref={scrollRef} />
      </div>

      <div className="p-3 bg-white border-t border-slate-200 flex gap-2">
        <input
          value={input}
          onChange={e => setInput(e.target.value)}
          onKeyDown={e => e.key === 'Enter' && handleSend()}
          placeholder="Ask a question or book..."
          className="flex-1 text-sm bg-slate-100 rounded-xl px-3 py-2 outline-none focus:ring-2 focus:ring-blue-500"
        />
        <button onClick={handleSend} className="p-2 bg-blue-600 text-white rounded-xl hover:bg-blue-700">
          <Send className="w-4 h-4" />
        </button>
      </div>
    </div>
  );
};
