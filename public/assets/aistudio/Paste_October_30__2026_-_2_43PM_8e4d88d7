```tsx
import React, { useState, useEffect } from 'react';
import { AppointmentRequest } from '../types';
import { CheckCircle2, Clock, Calendar, Download, Trash2, Edit3, ShieldAlert } from 'lucide-react';

export const AdminView: React.FC = () => {
  const [appointments, setAppointments] = useState<AppointmentRequest[]>([]);
  const [selected, setSelected] = useState<AppointmentRequest | null>(null);
  const [statusFilter, setStatusFilter] = useState('All');

  // Modal Action Form State
  const [actionDoctor, setActionDoctor] = useState('Dr. Sarah Jenkins');
  const [actionDate, setActionDate] = useState('');
  const [actionTime, setActionTime] = useState('');
  const [actionReason, setActionReason] = useState('');

  const fetchAppointments = async () => {
    try {
      const res = await fetch('/api/appointments', { credentials: 'same-origin' });
      if (res.ok) {
        const data = await res.json();
        setAppointments(data);
      }
    } catch {}
  };

  useEffect(() => { fetchAppointments(); }, []);

  const handleUpdate = async (id: string, newStatus: string) => {
    if (newStatus === 'Approved' && (!actionDoctor || !actionDate || !actionTime)) {
      alert('Please specify the assigned doctor, confirmed date, and time.');
      return;
    }
    if ((newStatus === 'Rejected' || newStatus === 'Rescheduled') && !actionReason.trim()) {
      alert('A reason is required to notify the patient via email.');
      return;
    }

    const res = await fetch(`/api/appointments/${id}`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        status: newStatus,
        assignedDoctor: actionDoctor,
        confirmedDate: actionDate,
        confirmedTime: actionTime,
        reason: actionReason
      })
    });

    if (res.ok) {
      setSelected(null);
      fetchAppointments();
    } else {
      const err = await res.json();
      alert(err.error || 'Update failed.');
    }
  };

  const handleDelete = async (id: string) => {
    if (confirm('Delete this appointment record?')) {
      await fetch(`/api/appointments/${id}`, { method: 'DELETE' });
      fetchAppointments();
    }
  };

  const filtered = statusFilter === 'All'
    ? appointments
    : appointments.filter(a => a.status === statusFilter);

  return (
    <div className="min-h-screen bg-slate-100 p-8">
      <div className="max-w-7xl mx-auto space-y-6">
        <div className="flex justify-between items-center bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
          <div>
            <h1 className="text-2xl font-black text-slate-900">Admin Appointment Portal</h1>
            <p className="text-sm text-slate-500">Manage patient bookings, assign doctors, and trigger automated emails</p>
          </div>
          <a href="/api/admin/export-csv" className="flex items-center gap-2 px-4 py-2 bg-slate-900 text-white rounded-xl text-sm font-semibold hover:bg-slate-800">
            <Download className="w-4 h-4" /> Export CSV
          </a>
        </div>

        {/* Status Filters */}
        <div className="flex gap-2">
          {['All', 'Pending', 'Approved', 'Rescheduled', 'Rejected'].map(s => (
            <button
              key={s}
              onClick={() => setStatusFilter(s)}
              className={`px-4 py-2 rounded-xl text-sm font-semibold transition ${
                statusFilter === s ? 'bg-blue-600 text-white' : 'bg-white text-slate-700 hover:bg-slate-200'
              }`}
            >
              {s}
            </button>
          ))}
        </div>

        {/* Appointments Table */}
        <div className="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
          <table className="w-full text-left text-sm text-slate-600">
            <thead className="bg-slate-50 text-slate-400 font-semibold uppercase text-xs border-b">
              <tr>
                <th className="p-4">Patient</th>
                <th className="p-4">Service</th>
                <th className="p-4">Date & Time</th>
                <th className="p-4">Doctor</th>
                <th className="p-4">Status</th>
                <th className="p-4 text-right">Actions</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-slate-100">
              {filtered.map(apt => (
                <tr key={apt.id} className="hover:bg-slate-50">
                  <td className="p-4 font-semibold text-slate-900">
                    {apt.firstName} {apt.lastName}
                    <div className="text-xs text-slate-400 font-normal">{apt.email} | {apt.phone}</div>
                  </td>
                  <td className="p-4">{apt.serviceName}</td>
                  <td className="p-4">
                    {apt.confirmedDate || apt.preferredDate}
                    <div className="text-xs text-slate-400">{apt.confirmedTime || apt.preferredTimeSlot}</div>
                  </td>
                  <td className="p-4">{apt.assignedDoctor || 'Unassigned'}</td>
                  <td className="p-4">
                    <span className={`px-2.5 py-1 rounded-full text-xs font-bold ${
                      apt.status === 'Approved' ? 'bg-emerald-100 text-emerald-700' :
                      apt.status === 'Rescheduled' ? 'bg-amber-100 text-amber-700' :
                      apt.status === 'Rejected' ? 'bg-red-100 text-red-700' : 'bg-blue-100 text-blue-700'
                    }`}>
                      {apt.status}
                    </span>
                  </td>
                  <td className="p-4 text-right space-x-2">
                    <button
                      onClick={() => {
                        setSelected(apt);
                        setActionDate(apt.confirmedDate || apt.preferredDate);
                        setActionTime(apt.confirmedTime || apt.preferredTimeSlot);
                        setActionDoctor(apt.assignedDoctor || 'Dr. Sarah Jenkins');
                      }}
                      className="px-3 py-1.5 bg-slate-100 text-slate-700 font-medium rounded-lg hover:bg-slate-200 text-xs"
                    >
                      Manage
                    </button>
                    <button onClick={() => handleDelete(apt.id)} className="p-1.5 text-red-500 hover:bg-red-50 rounded-lg">
                      <Trash2 className="w-4 h-4" />
                    </button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        {/* Action Modal */}
        {selected && (
          <div className="fixed inset-0 bg-black/50 backdrop-blur-sm flex items-center justify-center p-4 z-50">
            <div className="bg-white rounded-3xl max-w-lg w-full p-6 space-y-4 shadow-2xl">
              <h2 className="text-lg font-bold text-slate-900">Manage Appointment: {selected.firstName} {selected.lastName}</h2>
              <div className="space-y-3 text-sm">
                <div>
                  <label className="text-xs font-semibold text-slate-500">Assign Doctor</label>
                  <select value={actionDoctor} onChange={e => setActionDoctor(e.target.value)} className="w-full border p-2 rounded-xl mt-1">
                    <option>Dr. Sarah Jenkins</option>
                    <option>Dr. Michael Ross</option>
                  </select>
                </div>
                <div className="grid grid-cols-2 gap-3">
                  <div>
                    <label className="text-xs font-semibold text-slate-500">Date</label>
                    <input type="date" value={actionDate} onChange={e => setActionDate(e.target.value)} className="w-full border p-2 rounded-xl mt-1" />
                  </div>
                  <div>
                    <label className="text-xs font-semibold text-slate-500">Time</label>
                    <input type="text" value={actionTime} onChange={e => setActionTime(e.target.value)} placeholder="09:00 AM" className="w-full border p-2 rounded-xl mt-1" />
                  </div>
                </div>
                <div>
                  <label className="text-xs font-semibold text-slate-500">Reason (Required for Reschedule / Reject)</label>
                  <textarea value={actionReason} onChange={e => setActionReason(e.target.value)} placeholder="Explain the change to the patient..." className="w-full border p-2 rounded-xl mt-1 h-20 text-sm" />
                </div>
              </div>

              <div className="flex gap-2 pt-2">
                <button onClick={() => handleUpdate(selected.id, 'Approved')} className="flex-1 py-2.5 bg-emerald-600 text-white rounded-xl font-bold text-xs hover:bg-emerald-700">
                  Approve & Dispatch Calendar
                </button>
                <button onClick={() => handleUpdate(selected.id, 'Rescheduled')} className="flex-1 py-2.5 bg-amber-600 text-white rounded-xl font-bold text-xs hover:bg-amber-700">
                  Reschedule & Email
                </button>
                <button onClick={() => handleUpdate(selected.id, 'Rejected')} className="flex-1 py-2.5 bg-red-600 text-white rounded-xl font-bold text-xs hover:bg-red-700">
                  Decline Request
                </button>
              </div>
              <button onClick={() => setSelected(null)} className="w-full text-center text-xs text-slate-400 hover:text-slate-600 mt-2">Cancel</button>
            </div>
          </div>
        )}
      </div>
    </div>
  );
};
