// 3. Admin Update Appointment Status
app.patch('/api/appointments/:id', requireAdmin, (req: Request, res: Response) => {
  const { id } = req.params;
  const { status, assignedDoctor, confirmedDate, confirmedTime, reason, adminNotes } = req.body;

  const idx = appointmentDatabase.findIndex(a => a.id === id);
  if (idx === -1) return res.status(404).json({ error: 'Appointment not found.' });

  const existing = appointmentDatabase[idx];
  const oldStatus = existing.status;

  if (status === 'Approved' && (!assignedDoctor || !confirmedDate || !confirmedTime)) {
    return res.status(400).json({ error: 'Assigned doctor, confirmed date, and time are required for confirmation.' });
  }

  if ((status === 'Rejected' || status === 'Rescheduled') && !String(reason || '').trim()) {
    return res.status(400).json({ error: 'A reason is mandatory for patient notification.' });
  }

  appointmentDatabase[idx] = {
    ...existing,
    ...(status && { status }),
    ...(assignedDoctor && { assignedDoctor }),
    ...(confirmedDate && { confirmedDate }),
    ...(confirmedTime && { confirmedTime }),
    ...(reason && { reason }),
    ...(adminNotes !== undefined && { adminNotes })
  };

  persistAppointments();

  if (status && status !== oldStatus) {
    sendStatusEmail(appointmentDatabase[idx], status);
  }

  return res.json({ success: true, appointment: appointmentDatabase[idx] });
});

// 4. Admin Delete
app.delete('/api/appointments/:id', requireAdmin, (req: Request, res: Response) => {
  appointmentDatabase = appointmentDatabase.filter(a => a.id !== req.params.id);
  persistAppointments();
  res.json({ success: true });
});

